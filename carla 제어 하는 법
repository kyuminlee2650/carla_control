	-> follow_with_spectator : 설정을 안해주면 화면이 차량을 안 따라감. 아래 함수를 정의하여 world, 
	vehicle 객체를 입력해주면 알아서 차량을 따라감.
	------------------------------------------------
	def follow_with_spectator(world, vehicle, back=8.0, up=4.0, pitch=-15.0):
	    """Move the spectator to a 3rd-person chase view behind the vehicle."""
	    transform = vehicle.get_transform()
	    yaw = transform.rotation.yaw
	    offset = carla.Location(
		x=-back * math.cos(math.radians(yaw)),
		y=-back * math.sin(math.radians(yaw)),
		z=up,
	    )
	    spectator_transform = carla.Transform(
		transform.location + offset,
		carla.Rotation(pitch=pitch, yaw=yaw, roll=0.0),
	    )
	    world.get_spectator().set_transform(spectator_transform)
    	------------------------------------------------
    	
    	-> build_path : 현재 맵에 존재하는 spawn_point에서 시작 인덱스와 도착 인덱스를 고르면 
    	GlobalRoutePlanner라는 함수가 A* 알고리즘으로 글로벌 경로를 계획해줌. 이때 sampling_resolution을
    	이용하여 각 waypoint 간의 간격을 m단위로 설정할 수 있음. 경로의 x,y,yaw의 배열을 반환함.
    	------------------------------------------------------------------------------
    	def build_path(world, sampling_resolution=1, origin_index=0, dest_index=50):
	    """Trace a route with GlobalRoutePlanner and flatten it into x/y/yaw arrays."""
	    spawn_points = world.get_map().get_spawn_points()
	    dest_index = min(dest_index, len(spawn_points) - 1)
	    if dest_index == origin_index:
		dest_index = (origin_index + 1) % len(spawn_points)

	    origin_transform = spawn_points[origin_index]
	    destination = spawn_points[dest_index].location

	    grp = GlobalRoutePlanner(world.get_map(), sampling_resolution)
	    route = grp.trace_route(origin_transform.location, destination)
	    if len(route) < 2:
		raise RuntimeError("Route too short; pick a farther --dest-index.")

	    path_x = [wp.transform.location.x for wp, _ in route]
	    path_y = [wp.transform.location.y for wp, _ in route]
	    path_yaw = [math.radians(wp.transform.rotation.yaw) for wp, _ in route]
	    return origin_transform, path_x, path_y, path_yaw
    	------------------------------------------------------------------------------

