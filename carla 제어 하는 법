# 코드 기본 세팅
	---------------------------------------
	client = carla.Client(args.host, args.port) # 해당 포트와 해당 host의 carla 서버 tcp 접속
	client.set_timeout(10.0) 
	world = client.get_world()  # 현재 서버에 로드된 맵 핸들 획득. 새로 로드 안 함

	original_settings = world.get_settings()
	settings = world.get_settings()
	settings.synchronous_mode = True  # 동기 모드 on
	settings.fixed_delta_seconds = args.dt  # sampling time
	world.apply_settings(settings)  # settings를 실제 carla 환경 setting에 올림

	blueprint = world.get_blueprint_library().filter("vehicle.tesla.model3")[0]  # 차량모델지정
	spawn_point = world.get_map().get_spawn_points()[0]# 맵에 정의된 155개의 스폰 포인트 중 0번 지정
	vehicle = world.spawn_actor(blueprint, spawn_point)  # 위 정보들 기반으로 서버에 차량 액터를 생성
